# Port this service listens on (default: 3099)
WA_SERVICE_PORT=3099

# Must match WA_SERVICE_SECRET in your Next.js .env.local
WA_SERVICE_SECRET=change-me-to-a-random-string

# Optional persistent folder for encrypted Baileys retry messages.
# Default: whatsapp-service/auth_info-messages. In production, point this
# outside the deployed release directory so retries survive deployments.
# WA_MESSAGE_DIR=/var/lib/doorsmith/whatsapp-message-store
# Retry payloads expire automatically after this many hours (1-168).
WA_MESSAGE_TTL_HOURS=24
