<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="gg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0038A8" />
      <stop offset="100%" stop-color="#002166" />
    </linearGradient>
    <linearGradient id="accent-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F97316" />
      <stop offset="100%" stop-color="#D96D10" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#001845" flood-opacity="0.18" />
    </filter>
  </defs>

  <!-- Background Rounded Shield -->
  <rect x="24" y="24" width="464" height="464" rx="96" fill="url(#gg-grad)" filter="url(#shadow)" />

  <!-- Geometric Outer Ring Highlight -->
  <rect x="36" y="36" width="440" height="440" rx="84" fill="none" stroke="#FFFFFF" stroke-opacity="0.12" stroke-width="6" />

  <!-- Monogram GG Group -->
  <g transform="translate(68, 128)">
    <!-- First G -->
    <path d="M 130 50 A 90 90 0 1 0 130 210 L 130 140 L 90 140 L 90 180 L 130 180 A 50 50 0 1 1 130 90 Z" fill="#FFFFFF" />
    <path d="M 130 130 L 170 130 A 20 20 0 0 1 190 150 L 190 180 A 20 20 0 0 1 170 200 L 120 200 L 120 160 L 150 160 L 150 170 L 165 170 L 165 155 L 130 155 Z" fill="url(#accent-grad)" />

    <!-- Second G -->
    <g transform="translate(170, 0)">
      <path d="M 130 50 A 90 90 0 1 0 130 210 L 130 140 L 90 140 L 90 180 L 130 180 A 50 50 0 1 1 130 90 Z" fill="#FFFFFF" opacity="0.95" />
      <path d="M 130 130 L 170 130 A 20 20 0 0 1 190 150 L 190 180 A 20 20 0 0 1 170 200 L 120 200 L 120 160 L 150 160 L 150 170 L 165 170 L 165 155 L 130 155 Z" fill="url(#accent-grad)" />
    </g>
  </g>
</svg>
